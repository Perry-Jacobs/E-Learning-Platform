    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/winston": "^2.4.4",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
